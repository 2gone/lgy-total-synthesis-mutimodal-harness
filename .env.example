# Set these in a local shell or credential manager; never commit real credentials.
OPENAI_BASE_URL=https://provider.example.invalid/v1
OPENAI_API_KEY=

# Web route UI defaults to contract-mock: validate the interface without credentials/model calls.
# Set to cli only when a real provider integration is explicitly authorized.
TSDAF_WEB_ROUTE_MODE=contract-mock

# Local MinerU intake used by the Web workbench. The command defaults to mineru-kit on PATH.
TSDAF_MINERU_COMMAND=mineru-kit
TSDAF_MINERU_TIER=standard

# Optional compatible remote normalizer fallback. Local MinerU takes precedence when available.
TSDAF_UPSTREAM_PARSE_URL=https://parser.example.invalid/v1/paper-packages
TSDAF_UPSTREAM_PARSE_TOKEN=

# Optional directory containing <paper_id>/machine-paper-result.json recorded results.
# When omitted, the development workbench reads the immutable five-paper result commit if present.
TSDAF_CHEMISTRY_RESULTS_DIR=

# The research corpus pipeline is used for papers without a recorded result.
# It remains preflight-only until the user explicitly enables Live in the Web UI.
TSDAF_CHEMISTRY_MODEL=Gemini-3.8-flash
