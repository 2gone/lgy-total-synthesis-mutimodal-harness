{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemini total-synthesis evidence output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "visual_units",
    "scheme_text_items",
    "reaction_edges",
    "supporting_text_evidence",
    "reaction_evidence_packets",
    "uncertainties"
  ],
  "properties": {
    "paper_id": {
      "type": "string"
    },
    "visual_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "visual_id",
          "classification",
          "reason"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "visual_id": {
            "type": "string"
          },
          "panel": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "enum": [
              "MAIN_SYNTHESIS_ROUTE",
              "RETROSYNTHESIS",
              "MECHANISM",
              "OPTIMIZATION",
              "CONTROL_EXPERIMENT",
              "FAILED_OR_ALTERNATIVE_ROUTE",
              "BIOSYNTHESIS",
              "BACKGROUND",
              "CHARACTERIZATION",
              "OTHER"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scheme_text_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "visual_id",
          "raw_text",
          "text_type",
          "confidence"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "visual_id": {
            "type": "string"
          },
          "panel": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_text": {
            "type": "string"
          },
          "text_type": {
            "enum": [
              "compound_label",
              "step_label",
              "reagent_or_condition",
              "yield_or_selectivity",
              "other"
            ]
          },
          "reaction_relation": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reaction_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reaction_id",
          "page",
          "visual_id",
          "inputs",
          "outputs",
          "source_step_labels",
          "arrow_text",
          "confidence"
        ],
        "properties": {
          "reaction_id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "visual_id": {
            "type": "string"
          },
          "panel": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_step_labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "arrow_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "supporting_text_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "raw_text",
          "related_visual_ids",
          "related_reaction_ids",
          "relevance"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_text": {
            "type": "string"
          },
          "related_visual_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_reaction_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relevance": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reaction_evidence_packets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reaction_id",
          "image_facts",
          "text_evidence_refs",
          "conflicts"
        ],
        "properties": {
          "reaction_id": {
            "type": "string"
          },
          "image_facts": {
            "type": "object"
          },
          "text_evidence_refs": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "visual_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}